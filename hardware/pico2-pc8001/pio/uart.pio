; Eight PIO cycles per bit. Inversion is in PIO, not GPIO overrides.
; RX pushes bits 30:23=data, bit31=logical stop (1=valid), all lower bits ignored.
.program s10_rx_inverted
.wrap_target
start:
    wait 1 pin 0
    nop [3]
    jmp pin valid_start
    jmp start
valid_start:
    set x, 7 [5]
bits:
    in pins, 1
    jmp x-- bits [6]
    in pins, 1
    mov isr, ~isr
    push noblock
    wait 0 pin 0
.wrap

.program s10_rx_normal
.wrap_target
start:
    wait 0 pin 0
    nop [3]
    jmp pin start
    set x, 7 [5]
bits:
    in pins, 1
    jmp x-- bits [6]
    in pins, 1
    nop
    push noblock
    wait 1 pin 0
.wrap

.program s10_tx_inverted
.side_set 1 opt
.wrap_target
    pull block side 0
    mov osr, ~osr side 0
    set x, 7 side 1 [7]
bits:
    out pins, 1 [6]
    jmp x-- bits
    nop side 0 [7]
    mov isr, null
    push block
.wrap

.program s10_tx_normal
.side_set 1 opt
.wrap_target
    pull block side 1
    nop side 1
    set x, 7 side 0 [7]
bits:
    out pins, 1 [6]
    jmp x-- bits
    nop side 1 [7]
    mov isr, null
    push block
.wrap
